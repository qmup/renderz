{
  "name": "renderz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx tsx scripts/prepare-vercel-build.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe:renderz": "npx tsx scripts/probe-renderz.ts",
    "seed": "npx tsx --env-file=.env.local scripts/seed-listing.ts",
    "ingest": "npx tsx --env-file=.env.local scripts/ingest.ts",
    "catalog:verify": "npx tsx --env-file=.env.local scripts/verify-catalog.ts",
    "catalog:sync": "mkdir -p logs && set -o pipefail && caffeinate -dims npx tsx --env-file=.env.local scripts/scheduled-catalog-sync.ts 2>&1 | tee \"logs/catalog-sync-$(date +%Y%m%d-%H%M).log\"",
    "catalog:backfill-colors": "caffeinate -dims npx tsx --env-file=.env.local scripts/backfill-card-colors.ts",
    "catalog:reparse": "caffeinate -dims npx tsx --env-file=.env.local scripts/reparse-catalog.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "json5": "^2.2.3",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
