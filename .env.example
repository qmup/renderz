SQLITE_PATH=data/catalog.sqlite

# Aurora PostgreSQL writer. Login is IAM (no password in this file).
# On Vercel, also set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# Locally, the AWS CLI profile in ~/.aws is enough.
AURORA_HOST=renderz.cluster-cv4068ogwct9.ap-southeast-1.rds.amazonaws.com
AURORA_PORT=5432
AURORA_USER=postgres
AURORA_DATABASE=postgres
AWS_REGION=ap-southeast-1
S3_BUCKET=renderz-bucket

# Card art and LOOP sheets. Empty keeps same-origin /player-art and /loops.
NEXT_PUBLIC_IMAGE_BASE_URL=https://dl6zq1ade97rj.cloudfront.net

# Upstream RenderZ fetch limiter (used from M2). Defaults: concurrency 1, ~1 req/s.
RENDERZ_MAX_CONCURRENCY=1
RENDERZ_REQUESTS_PER_SECOND=1
RENDERZ_MAX_RETRIES=4
RENDERZ_BACKOFF_BASE_MS=500
RENDERZ_BACKOFF_MAX_MS=8000
RENDERZ_REQUEST_TIMEOUT_MS=15000
