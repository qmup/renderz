# Neon Postgres (provisioned through the Vercel Marketplace; `vercel env pull` fills it in).
DATABASE_URL=

# Cloudflare R2 bucket for card art, used by the catalog sync scripts.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=renderz-bucket

# Card art and LOOP sheets. Empty keeps same-origin /player-art and /loops.
NEXT_PUBLIC_IMAGE_BASE_URL=https://pub-4504f6876faf4bdbb4c89290c7743cb3.r2.dev

# Upstream RenderZ fetch limiter (used from M2). Defaults: concurrency 1, ~1 req/s.
RENDERZ_MAX_CONCURRENCY=1
RENDERZ_REQUESTS_PER_SECOND=1
RENDERZ_MAX_RETRIES=4
RENDERZ_BACKOFF_BASE_MS=500
RENDERZ_BACKOFF_MAX_MS=8000
RENDERZ_REQUEST_TIMEOUT_MS=15000
