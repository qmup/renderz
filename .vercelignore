# Same as .gitignore, except data/images.sqlite is uploaded so production
# can serve player art without calling RenderZ from Vercel IPs.

/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/data/*.sqlite
/data/*.sqlite-*
!/data/catalog.snapshot.sqlite
!/data/images.sqlite
/data/image-cache/

/test/fixtures/renderz/raw/*
!/test/fixtures/renderz/raw/.gitkeep

/coverage
/.next/
/out/
/build
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
!.env.example
.vercel
*.tsbuildinfo
next-env.d.ts
.git
